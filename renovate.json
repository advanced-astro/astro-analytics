{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Default preset for use with Redwerkz's repos",
    "extends": [
      "config:recommended"
    ],
    "dependencyDashboard": {
        "enabled": true
    },
    "forkProcessing": "enabled",
    "packageRules": [
      {
        "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
        "automerge": true
      }
    ]
  }
  
